{
  "expo": {
    "name": "Trainingsbegleiter",
    "newArchEnabled": false,
    "slug": "fitness-nfc-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NFCReaderUsageDescription": "Diese App nutzt NFC, um Fitnessgeräte anhand ihrer Tags zu erkennen."
      }
    },
    "android": {
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ],
      "package": "com.snowfox22.fitnessnfctracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Diese App nutzt NFC, um Fitnessgeräte anhand ihrer Tags zu erkennen.",
          "selectIdentifiers": [],
          "systemCodes": []
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-asset",
      "expo-sharing",
      "expo-notifications"
    ]
  }
}
